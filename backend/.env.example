# Public base URL Agora's cloud must be able to reach (ngrok tunnel URL during the event)
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# Agora — from console.agora.io
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Separate REST credential pair (console > RESTful API), not the App ID/Certificate above
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# TTS vendor (primary: ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Gemini — from Google AI Studio
GEMINI_API_KEY=

# Vobiz — escalation WhatsApp send (optional; escalation falls back to in-app banner if unset)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CASEWORKER_WHATSAPP_NUMBER=

# SQLite file path
DATABASE_URL=sqlite:///./case_files.db
